<?xml version="1.0" encoding="utf-8" ?>
<!-- xmlns means xml namespace -->
<!-- xmlns:x gives and alias to the namespace for faster referencing -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ScratchMAUI.MainPage">

    <!-- EVERY visual element in MAUI is just a C# object.
        Using the tag is exactly the same as calling the constructor.
        
        Elements can be classified into two categories:
            - Layout: 
                - May have many child elements
                - Has a Children property
                - This is the "where"; determines how to display a collection of elements
            - Content: 
                - May have up to a single child element
                - Sometimes has a Content Property
                - This is the "what"; displays some kind of chosen information to the user
    -->
    <Grid RowDefinitions="1*, 2*" ColumnDefinitions="*, *, *, *">
        <Label Grid.Row="0" Grid.ColumnSpan="4" Style="{StaticResource LayoutLabel}">Horizontal Stack</Label>
        <Border Grid.ColumnSpan="4" Stroke="Bisque" Margin="10">
            <HorizontalStackLayout>
                <Label BackgroundColor="MediumAquamarine" Style="{StaticResource ContentLabel}">1</Label>
                <Label BackgroundColor="DarkGoldenrod" Style="{StaticResource ContentLabel}">2</Label>
                <Label BackgroundColor="LightGrey" Style="{StaticResource ContentLabel}">3</Label>
                <Label BackgroundColor="Crimson" Style="{StaticResource ContentLabel}">4</Label>
                <Label BackgroundColor="MediumPurple" Style="{StaticResource ContentLabel}">5</Label>
                <Label BackgroundColor="ForestGreen" Style="{StaticResource ContentLabel}">6</Label>
                <Label BackgroundColor="Firebrick" Style="{StaticResource ContentLabel}">7</Label>
                <Label BackgroundColor="DeepSkyBlue" Style="{StaticResource ContentLabel}">8</Label>
                <Label BackgroundColor="GreenYellow" Style="{StaticResource ContentLabel}">9</Label>
                <Label BackgroundColor="SlateGray" Style="{StaticResource ContentLabel}">10</Label>
            </HorizontalStackLayout>
        </Border>
    </Grid>
</ContentPage>
